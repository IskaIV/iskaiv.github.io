---
import Brand from './Brand.astro';
import Icon from './Icon.astro';
import { navigation, site } from '../data/site';
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-top"><div><Brand /><p>Practical engineering.<br />A more connected business.</p></div><nav aria-label="Footer navigation">{navigation.map(({ label, href }) => <a href={href}>{label}</a>)}<a href="/contact/">Contact</a></nav><div class="footer-contact"><a href={`mailto:${site.email}`}>{site.email}</a><a href={site.github}>GitHub <Icon name="arrow-up" size={14} /></a></div></div>
    <div class="footer-bottom"><span>© {new Date().getFullYear()} {site.brand} · {site.name}</span><span>{site.location}</span><a href="#top">Back to top ↑</a></div>
  </div>
</footer>
