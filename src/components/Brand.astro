---
interface Props { inverse?: boolean; }
const { inverse = false } = Astro.props;
---
<a class:list={['brand', { 'brand--inverse': inverse }]} href="/" aria-label="IVy TechOps home">
  <svg class="brand__mark" width="36" height="36" viewBox="0 0 36 36" fill="none" aria-hidden="true"><rect width="36" height="36" rx="9" fill="currentColor" /><path d="M11 10v16m5-16 5 16 5-16" stroke="var(--paper)" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" /></svg>
  <span><strong>IVy</strong> <span class="brand__ops">TechOps</span></span>
</a>
